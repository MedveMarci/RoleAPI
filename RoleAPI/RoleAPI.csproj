<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <AssemblyName>RoleAPI</AssemblyName>
        <RootNamespace>RoleAPI</RootNamespace>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PlatformTarget>x64</PlatformTarget>
        <Platforms>x64</Platforms>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <Nullable>enable</Nullable>
        <Configurations>Debug;Release;Debug-RueI;Release-RueI</Configurations>
        <PackageId>RoleAPI</PackageId>
        <Version>2.0.0</Version>
        <Authors>MedveMarci</Authors>
        <Description>Additive role ability and schematic framework for SCP:SL plugins.</Description>
        <PackageTags>SCP;SL;LabAPI;Plugin;RoleAPI;ProjectMER</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>embedded</DebugType>
        <Optimize>false</Optimize>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <OutputPath>bin\x64\Debug\</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <DefineConstants>TRACE</DefineConstants>
        <OutputPath>bin\x64\Release\</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug-RueI|x64'">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>embedded</DebugType>
        <Optimize>false</Optimize>
        <DefineConstants>DEBUG;TRACE;RueI</DefineConstants>
        <OutputPath>bin\x64\Debug-RueI\</OutputPath>
        <AssemblyName>RoleAPI-RueI</AssemblyName>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release-RueI|x64'">
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <DefineConstants>TRACE;RueI</DefineConstants>
        <OutputPath>bin\x64\Release-RueI\</OutputPath>
        <AssemblyName>RoleAPI-RueI</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Northwood.LabAPI" Version="1.1.7" />
        <PackageReference Include="SecretLabNAudio.Core" Version="2.1.0"/>
        <PackageReference Include="System.Net.Http" Version="4.3.4"/>
        <PackageReference Include="System.Text.Json" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="UncomplicatedCustomRoles" HintPath="$(LABAPI_PLUGINS)\UncomplicatedCustomRoles.dll"/>
        <Reference Include="ProjectMER" HintPath="$(LABAPI_PLUGINS)\ProjectMER.dll"/>
        <Reference Include="SecretAPI" HintPath="$(LABAPI_PLUGINS)\SecretAPI.dll"/>
        <Reference Include="HintServiceMeow" HintPath="$(LABAPI_PLUGINS)\HintServiceMeow.dll"/>
        <Reference Include="Assembly-CSharp" HintPath="$(SL_REFERENCES)\Assembly-CSharp.dll" Publicize="true"/>
        <Reference Include="Assembly-CSharp-firstpass" HintPath="$(SL_REFERENCES)\Assembly-CSharp-firstpass.dll"/>
        <Reference Include="UnityEngine.CoreModule" HintPath="$(SL_REFERENCES)\UnityEngine.CoreModule.dll"/>
        <Reference Include="UnityEngine.AnimationModule" HintPath="$(SL_REFERENCES)\UnityEngine.AnimationModule.dll"/>
        <Reference Include="UnityEngine.PhysicsModule" HintPath="$(SL_REFERENCES)\UnityEngine.PhysicsModule.dll"/>
        <Reference Include="NorthwoodLib" HintPath="$(SL_REFERENCES)\NorthwoodLib.dll"/>
        <Reference Include="Mirror" HintPath="$(SL_REFERENCES)\Mirror.dll"/>
        <Reference Include="CommandSystem.Core" HintPath="$(SL_REFERENCES)\CommandSystem.Core.dll"/>
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug-RueI' Or '$(Configuration)' == 'Release-RueI'">
        <PackageReference Include="RueI" Version="3.1.2"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\README.md" Link="README.md"/>
        <Content Include="..\LICENSE" Link="LICENSE"/>
        <Content Include="..\CHANGELOG.md" Link="CHANGELOG.md"/>
        <Content Include="..\DOCUMENTATION.md" Link="DOCUMENTATION.md"/>
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(LABAPI_PLUGINS)' != ''">
        <Exec Command="xcopy &quot;$(TargetPath)&quot; &quot;$(LABAPI_PLUGINS)&quot; /y"/>
    </Target>
</Project>
